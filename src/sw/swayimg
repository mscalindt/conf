OBJ=\
'swayimg.overlay = true
swayimg.decoration = false
swayimg.viewer.set_window_background(0x00000000)
swayimg.antialiasing = true
swayimg.text.size = 24
swayimg.text.padding = 0
swayimg.text.timeout = 0
swayimg.text.shadow = 0xff000000
swayimg.viewer.default_scale = "fit"

swayimg.viewer.text = {
  topleft = {
    "Scale:  {scale}",
  },
  topright = {
  },
  bottomleft = {
    "File name:   {name}",
    "File size:   {sizehr}",
    "File time:   {time}",
    "Image size:  {frame.width}x{frame.height}",
  },
  bottomright = {
    "Camera:    {meta.Exif.Image.Model}",
    "Exposure:  {meta.Exif.Image.ExposureTime}",
    "F Number:  {meta.Exif.Image.FNumber}",
    "ISO:       {meta.Exif.Image.ISOSpeedRatings}",
    "Time:      {meta.Exif.Photo.DateTimeOriginal}",
  },
}

swayimg.text.font = "Source Code Pro"

swayimg.on_window_resize(function()
  swayimg.viewer.set_fix_scale("optimal")
end)

swayimg.viewer.on_key("q", function()
  swayimg.exit()
end)
