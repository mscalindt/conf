OBJ=\
'map D console delete
copymap K <A-a>
copymap J <A-s>
set autosave_bookmarks false
set display_free_space_in_status_bar false
set display_size_in_status_bar false
set draw_borders both
set hostname_in_titlebar false
set idle_delay 100
set max_console_history_size 100
set mouse_enabled false
set tilde_in_titlebar true
set preview_max_size 1010101
set save_console_history false
'
OBJ_PATH="$home/.config/ranger/rc.conf"
__file_write_ow_soft \
    -uid "$uid" -gid "$gid" \
    -user "$user" -group "$group"

OBJ=\
'# DEFAULTS (the format is FIFO)
ext 1|5 = man "$@"

# Text
ext 1|5, has emacsclient, X, flag f = emacsclient -n "$@"
ext ini, has emacsclient, X, flag f = emacsclient -n "$@"
ext js, has emacsclient, X, flag f = emacsclient -n "$@"
ext sh, has emacsclient, X, flag f = emacsclient -n "$@"
ext shfn, has emacsclient, X, flag f = emacsclient -n "$@"
mime ^text, has emacsclient, X, flag f = emacsclient -n "$@"
mime ^inode/x-empty$, has emacsclient, X, flag f = emacsclient -n "$@"
ext 1|5, has featherpad, X, flag f = featherpad "$@"
ext ini, has featherpad, X, flag f = featherpad "$@"
ext js, has featherpad, X, flag f = featherpad "$@"
ext sh, has featherpad, X, flag f = featherpad "$@"
ext shfn, has featherpad, X, flag f = featherpad "$@"
mime ^text, has featherpad, X, flag f = featherpad "$@"
mime ^inode/x-empty$, has featherpad, X, flag f = featherpad "$@"

# Video
mime ^video, has mpv, X, flag f = mpv --profile=video-cfg -- "$@"

# Audio
mime ^audio, has mpv, X, flag f = mpv --profile=audio-cfg -- "$@"

# Images
ext xcf, has gimp, X, flag f = gimp -- "$@"
mime ^image/svg, has inkscape, X, flag f = inkscape -- "$@"
mime ^image/svg, has display, X, flag f = display -- "$@"
mime ^image, has swayimg, X, flag f = swayimg -- "$@"
mime ^image, has gimp, X, flag f = gimp -- "$@"

# Documents
ext pdf, has firefox, X, flag f = firefox -- "$@"

# Archives (atool)
ext 7z|ace|ar|arc|bz2?|cab|cpio|cpt|deb|dgc|dmg|gz|iso|jar|msi|pkg|rar|shar|tar|tgz|xar|xpi|xz|zip, has atool = atool --list --each -- "$@" | "$PAGER"
ext 7z|ace|ar|arc|bz2?|cab|cpio|cpt|deb|dgc|dmg|gz|iso|jar|msi|pkg|rar|shar|tar|tgz|xar|xpi|xz|zip, has atool = atool --extract --each -- "$@"
ext kmz, has atool = atool --format zip --list --each -- "$@" | "$PAGER"
ext kmz, has atool = atool --format zip --extract --each -- "$@"

# Archives
ext zst, has tar = tar -vvtf "$@" | "$PAGER"
ext zst, has tar = tar --one-top-level -vvxf "$@"

# Misc
ext x?html?, has firefox, X, flag f = firefox -- "$@"
ext x?html?, has chromium, X, flag f = chromium -- "$@"
'
OBJ_PATH="$home/.config/ranger/rifle.conf"
__file_write_ow_soft \
    -uid "$uid" -gid "$gid" \
    -user "$user" -group "$group"
